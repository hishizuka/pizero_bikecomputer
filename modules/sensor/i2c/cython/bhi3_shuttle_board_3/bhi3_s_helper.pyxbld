def make_ext(modname, pyxfilename):
    import os
    from pathlib import Path

    from setuptools import Extension

    base = Path(pyxfilename).resolve().parent
    library_dirs = [
        directory for directory in os.environ.get("LD_LIBRARY_PATH", "").split(":")
        if directory
    ] + ["/usr/lib", "/usr/local/lib", str(base)]

    target = os.environ.get("BHI3_TARGET", "").strip().lower().removeprefix("bhi")
    targets = (f"bhi{target}",) if target in ("360", "385") else ("bhi360", "bhi385")
    library = next(
        (
            name for name in targets
            if any((Path(directory) / f"lib{name}.so").is_file() for directory in library_dirs)
        ),
        None,
    )
    if library is None:
        raise ImportError(f"SensorAPI library unavailable for {', '.join(targets)}")

    macros = [(name, "1") for name in ("NOUSE_MAIN", "USE_BHI3_S", "BHI3_USE_I2C")]
    if library == "bhi385":
        macros.append(("USE_BHI385", "1"))

    return Extension(
        name=modname,
        sources=[pyxfilename, str(base / "common.c"), str(base / "bhi3_s.c")],
        include_dirs=[str(base)],
        library_dirs=library_dirs,
        libraries=[library, "gpiod", "pthread", "m"],
        define_macros=macros,
        depends=[str(header) for header in base.glob("*.h")]
        + [__file__],
    )
